{
  "name": "format-anthropic-messages",
  "purpose": "A tool call and a final answer in the anthropic_messages wire format.",
  "guide": "7.2: anthropic_messages format",
  "mode": "anthropic_messages",
  "steps": [
    {
      "reply": "I will run it.",
      "toolCalls": [
        {
          "id": "call_1",
          "name": "terminal",
          "arguments": {
            "command": "echo hello"
          }
        }
      ]
    },
    {
      "reply": "It printed hello."
    }
  ],
  "config": {
    "systemPrompt": "You are a helpful agent.\n\nConversation started: a scripted day.",
    "systemPromptStatic": "You are a helpful agent."
  },
  "commands": {
    "echo hello": {
      "stdout": "hello\n"
    }
  },
  "inputs": [
    {
      "send": "say hello in the shell"
    }
  ],
  "expect": {
    "replies": [
      "It printed hello."
    ],
    "requests": 2,
    "toolRuns": 1
  },
  "upstream": {
    "ignore": [
      "@system",
      "@tools"
    ]
  }
